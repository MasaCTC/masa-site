DATABASE_URL=
DATABASE_URL_UNPOOLED=
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=
AUTH_SECRET=
PLANNER_ENCRYPTION_KEY=
# Signs every MCP connector OAuth token (stateless; no table). At least 32
# characters; generate with: openssl rand -base64 48
# Rotating it revokes every connector token (Claude must reconnect).
MCP_OAUTH_SECRET=
# Instagram Graph API, system-user token: instagram_basic + instagram_manage_insights. Server-only, never expose.
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_USER_ID=
